<UserControl x:Class="SpokaPilote.App.Views.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SpokaPilote.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
             xmlns:l="clr-namespace:SpokaPilote.App.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DriversViewModel}"
             AutomationProperties.Name="Pilotes">
    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ en-tête -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
                <Button Content="Exporter le rapport..." Command="{Binding ExportReportCommand}" Margin="0,0,8,0"
                        ToolTip="Rapport de ce poste au format HTML ou JSON" />
                <Button Content="Analyser à nouveau" Command="{Binding Shell.ScanCommand}" ToolTip="Analyser à nouveau (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Pilotes" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Pilotes proposés pour ce poste. Chacun vient d'une source officielle et est vérifié (signature, compatibilité) avant d'être installé. Les pilotes optionnels et les BIOS ne sont pas cochés d'office." />
            </StackPanel>
        </DockPanel>

        <!-- ============================================ filtres et sélection -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding Shell.HasScan, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel AutomationProperties.Name="Filtrer les pilotes">
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DriverFilter" AutomationProperties.Name="Tous les pilotes"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=all}">
                    <TextBlock><Run Text="Tout" /> <Run Text="{Binding TotalCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DriverFilter" AutomationProperties.Name="Pilotes manquants"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=missing}">
                    <TextBlock><Run Text="Manquants" /> <Run Text="{Binding MissingCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DriverFilter" AutomationProperties.Name="Mises à jour"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=updates}">
                    <TextBlock><Run Text="Mises à jour" /> <Run Text="{Binding UpdateCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DriverFilter" AutomationProperties.Name="Pilotes bloqués par la politique"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=blocked}">
                    <TextBlock><Run Text="Bloqués" /> <Run Text="{Binding BlockedCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
            </WrapPanel>
        </DockPanel>

        <!-- ============================================ liste -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                  RowDetailsVisibilityMode="VisibleWhenSelected" AutomationProperties.Name="Liste des pilotes proposés"
                  Visibility="{Binding IsListEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                            <Setter Property="Opacity" Value="0.72" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserResize="False">
                    <!-- Case de l'en-tête : tout cocher / tout décocher (pilotes affichés). -->
                    <DataGridTemplateColumn.Header>
                        <CheckBox MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  ToolTip="{l:T 'Tout cocher ou tout décocher'}" AutomationProperties.Name="{l:T 'Tout cocher ou tout décocher'}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:CandidateItem}">
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable, Mode=OneWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"
                                      AutomationProperties.Name="{Binding Title}" ToolTip="{l:T 'Installer ce pilote'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Pilote" Width="3*" MinWidth="190" SortMemberPath="Title" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:CandidateItem}">
                            <StackPanel Margin="4,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Subtitle}" Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.2*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="État" Width="1.3*" MinWidth="110" SortMemberPath="Status" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:CandidateItem}">
                            <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <!-- Détail à la demande : ligne sélectionnée. -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type vm:CandidateItem}">
                    <Border Margin="52,0,12,12" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,16,4" Text="{l:T 'Périphérique(s)'}" />
                            <TextBlock Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding Devices}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,16,4" Text="{l:T 'Date'}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Date}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,0,16,4" Text="{l:T 'Taille'}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Size}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,0,16,4" Text="{l:T 'Détail'}"
                                       Visibility="{Binding StatusDetail, Converter={StaticResource VisibleWhen}}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource Mono}" FontFamily="Segoe UI" FontSize="13"
                                     Text="{Binding StatusDetail, Mode=OneWay}" Visibility="{Binding StatusDetail, Converter={StaticResource VisibleWhen}}" />
                            <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T 'Ouvrir la page officielle'}"
                                    ToolTip="{Binding InfoUrl}"
                                    Command="{Binding DataContext.Shell.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding InfoUrl}"
                                    Visibility="{Binding HasInfoUrl, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- État vide : dire quoi faire ensuite. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28,24"
                Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <app:Glyph Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE896;" />
                <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle, Mode=OneWay}" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" Style="{StaticResource Secondary}" Text="{Binding EmptyText, Mode=OneWay}" />
                <Button Margin="0,16,0,0" HorizontalAlignment="Center" Style="{DynamicResource AccentButtonStyle}" Content="Analyser ce poste"
                        Command="{Binding Shell.ScanCommand}" ToolTip="Analyser ce poste (F5)"
                        Visibility="{Binding Shell.HasScan, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
            </StackPanel>
        </Border>

        <!-- ============================================ installation -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                Visibility="{Binding Shell.HasScan, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Simuler" Command="{Binding SimulateCommand}" Margin="0,0,8,0"
                            ToolTip="Télécharge et vérifie les pilotes cochés, sans rien installer" />
                    <Button Content="{Binding InstallLabel, Mode=OneWay}" Command="{Binding InstallCommand}" Style="{DynamicResource AccentButtonStyle}"
                            AutomationProperties.Name="{Binding InstallLabel, Mode=OneWay}" Padding="18,6" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Avant d'installer :" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Secondary}" />
                    <CheckBox Content="Point de restauration" IsChecked="{Binding Shell.CreateRestorePoint}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="Sauvegarder les pilotes actuels" IsChecked="{Binding Shell.BackupDrivers}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============================================ options et détails techniques -->
        <Expander Grid.Row="4" Margin="0,10,0,0" Header="Options d'analyse, sources et politique">
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,0">
                <CheckBox Content="Chercher aussi les mises à jour des composants qui fonctionnent (analyse approfondie)" IsChecked="{Binding DeepScan}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="{Binding SourcesUsed, Mode=OneWay}"
                           Visibility="{Binding SourcesUsed, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Sources qui n'ont pas répondu"
                           Visibility="{Binding HasSourceWarnings, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding SourceWarnings, Mode=OneWay}"
                           Visibility="{Binding HasSourceWarnings, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Politique de pilotes" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding PolicySummary, Mode=OneWay}" />
            </StackPanel>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
