<UserControl x:Class="SpokaPilote.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SpokaPilote.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
             xmlns:install="clr-namespace:SpokaPilote.Core.Install;assembly=SpokaPilote.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             AutomationProperties.Name="Historique">
    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,6,0,0" Content="Actualiser" Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Historique" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Tout ce que SpokaPilote a modifié sur ce poste (installations, réparations, nettoyages). Sélectionnez une intervention pour voir son détail ; «&#160;Annuler cette intervention&#160;» retire les pilotes qu'elle a ajoutés et chaque périphérique revient à son pilote précédent." />
            </StackPanel>
        </DockPanel>

        <!-- État vide. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28,24"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <app:Glyph Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE81C;" />
                <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource CardTitle}" Text="Aucune intervention pour l'instant" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" Style="{StaticResource Secondary}"
                           Text="Les installations, réparations et nettoyages faits avec SpokaPilote apparaîtront ici, avec la possibilité de les annuler." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Interventions}" SelectedItem="{Binding SelectedRow}" Padding="4"
                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Interventions">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InterventionRow}">
                        <StackPanel Margin="4,6">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding State}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{Binding RollbackHint, Mode=OneWay}" />
                        <Button HorizontalAlignment="Left" Content="Annuler cette intervention" Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding RollbackCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="Détail" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Style="{StaticResource Mono}" FontFamily="Segoe UI" FontSize="13"
                                 Text="{Binding SelectedInterventionDetails, Mode=OneWay}" AutomationProperties.Name="Détail de l'intervention" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Sauvegardes : recours si l'annulation ne suffit pas. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Réinstaller cette sauvegarde" Command="{Binding RestoreBackupCommand}"
                            Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Text="Sauvegardes de pilotes" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="Aucune sauvegarde pour l'instant."
                               Visibility="{Binding HasBackups, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                    <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Label"
                              ToolTip="{Binding SelectedBackup.Path}" AutomationProperties.Name="Sauvegardes de pilotes"
                              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                           Text="Les pilotes en place sont sauvegardés avant chaque installation (option de la page Pilotes). Réinstaller une sauvegarde est le recours si l'annulation ne suffit pas." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
