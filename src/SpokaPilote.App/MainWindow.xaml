<Window x:Class="SpokaPilote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpokaPilote — pilotes de confiance"
        Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="0" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="MinWidth" Value="190" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>

            <!-- ====================================================== CE POSTE -->
            <TabItem AutomationProperties.Name="Ce poste" ToolTip="Ce poste (Ctrl+1)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">🖥  Ce poste</TextBlock>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding MachineTitle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding MachineDetails}" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Mettre à jour" Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallUpdateCommand}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                                    <Run FontWeight="SemiBold" Text="{Binding UpdateLabel, Mode=OneWay}" />
                                    <Run Text="Téléchargement depuis GitHub, vérifié (taille + SHA-256), puis installation automatique." />
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                                Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Relancer en administrateur" Command="{Binding RelaunchAsAdminCommand}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                                    <Run FontWeight="SemiBold">Mode analyse.</Run>
                                    <Run>L'inventaire et la recherche fonctionnent ; l'installation de pilotes et d'imprimantes demande les droits administrateur.</Run>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding HealthHeadline}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"
                                               Text="Sources interrogées : dépôt interne, catalogue officiel du constructeur (Dell, HP, Lenovo), Windows Update et Microsoft Update Catalog. Rien d'autre." />
                                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding DeepScan}"
                                              Content="Analyse approfondie (cherche aussi des mises à jour pour les composants qui fonctionnent)" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="24,0,0,0" Padding="28,12" FontSize="15" VerticalAlignment="Center"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Content="Analyser ce poste" Command="{Binding ScanCommand}" ToolTip="Analyser ce poste (F5)" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding SummaryDevices}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="périphériques détectés" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding SummaryProblems}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="en erreur" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding SummaryCandidates}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="pilotes proposés" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding SummaryUnresolved}" />
                                    <TextBlock Style="{StaticResource TileLabel}" Text="sans solution automatique" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                                Visibility="{Binding HasSourceWarnings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="⚠ Sources partiellement disponibles" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SourceWarnings}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                                Visibility="{Binding HasHealth, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="84" Height="84" CornerRadius="42" VerticalAlignment="Top" Margin="0,0,20,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding HealthGrade, Mode=OneWay}" FontSize="42" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="Note de santé des pilotes" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="Santé des pilotes" />
                                    <TextBlock Opacity="0.85" Text="{Binding HealthScoreText, Mode=OneWay}" />
                                    <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Opacity="0.8" Text="{Binding HealthSummaryText, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{Binding HealthFindings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="{Binding SeverityLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap" Text="{Binding Detail, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Politique de pilotes" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" Text="{Binding PolicySummary, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Périphériques sans pilote trouvé" />
                        <ItemsControl ItemsSource="{Binding UnresolvedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Opacity="0.75" Text="{Binding Status}" />
                                            <TextBlock FontFamily="Consolas" FontSize="12" Opacity="0.75" Text="{Binding HardwareId}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Hint}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Opacity="0.6" Text="Aucun pour l'instant." Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnresolvedDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Content="Exporter le rapport (HTML / JSON)" Command="{Binding ExportHtmlCommand}" />

                        <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Nettoyage du magasin de pilotes" />
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Windows garde toutes les anciennes versions de pilotes. SpokaPilote repère celles qui ne servent plus et ont été remplacées (jamais un pilote utilisé, jamais la seule version, jamais un pilote d'imprimante), les sauvegarde puis les supprime." />
                                <WrapPanel>
                                    <Button Content="Analyser le magasin" Command="{Binding AnalyzeDriverStoreCommand}" Margin="0,0,8,0" />
                                    <Button Content="Nettoyer..." Command="{Binding CleanDriverStoreCommand}" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85" Text="{Binding DriverStoreText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== PILOTES -->
            <TabItem AutomationProperties.Name="Pilotes" ToolTip="Pilotes (Ctrl+2)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">⬇  Pilotes</TextBlock>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Pilotes proposés" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Chaque paquet est téléchargé depuis la source officielle, contrôlé (empreinte + signature numérique d'un éditeur approuvé + compatibilité réelle avec le matériel) avant installation. Les pilotes optionnels et les BIOS/firmwares ne sont pas cochés par défaut." />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="Tout cocher" Command="{Binding SelectAllCommand}" Margin="0,0,8,8" />
                        <Button Content="Tout décocher" Command="{Binding SelectNoneCommand}" Margin="0,0,24,8" />
                        <CheckBox Content="Point de restauration" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <CheckBox Content="Sauvegarder les pilotes actuels" IsChecked="{Binding BackupDrivers}" Margin="0,0,24,8" VerticalAlignment="Center" />
                        <Button Content="Simuler (télécharger et vérifier)" Command="{Binding SimulateCommand}" Margin="0,0,8,8" />
                        <Button Content="Installer la sélection" Command="{Binding InstallCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable, Mode=OneWay}" HorizontalAlignment="Center" MinWidth="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Pilote" Binding="{Binding Title}" Width="3*" MinWidth="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="86" IsReadOnly="True" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Périphérique(s)" Binding="{Binding Devices}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Détails" Padding="6,2" FontSize="12" ToolTip="{Binding InfoUrl}"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding InfoUrl}"
                                                Visibility="{Binding HasInfoUrl, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="État" Width="1.5*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" ToolTip="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== PÉRIPHÉRIQUES -->
            <TabItem AutomationProperties.Name="Périphériques" ToolTip="Périphériques (Ctrl+3)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">🧩  Périphériques</TextBlock>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Inventaire matériel" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Tous les composants détectés, leur pilote actuel et leur état. Sélectionnez un périphérique en erreur pour le diagnostic et la réparation guidée." />
                        <CheckBox Content="Afficher aussi les périphériques logiciels et virtuels" IsChecked="{Binding ShowAllDevices}" Margin="0,0,0,12" />
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding HasRepairPlan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Réparation guidée" />
                            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Text="{Binding RepairPlanText, Mode=OneWay}" />
                            <WrapPanel>
                                <ComboBox ItemsSource="{Binding RepairPlan.Actions, Mode=OneWay}" SelectedItem="{Binding SelectedRepairAction}"
                                          DisplayMemberPath="Label" MinWidth="260" Margin="0,0,8,0" AutomationProperties.Name="Action de réparation" />
                                <Button Content="Appliquer" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ExecuteRepairCommand}" />
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedRepairAction.Explanation, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding RepairResultText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedDevice}" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Hint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="36" />
                            <DataGridTextColumn Header="Périphérique" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="110" />
                            <DataGridTextColumn Header="Version du pilote" Binding="{Binding DriverVersion}" Width="140" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DriverDate}" Width="90" />
                            <DataGridTextColumn Header="Fournisseur" Binding="{Binding Provider}" Width="1*" />
                            <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="ID matériel" Binding="{Binding HardwareId}" Width="1.6*" FontFamily="Consolas" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== IMPRIMANTES -->
            <TabItem AutomationProperties.Name="Imprimantes" ToolTip="Imprimantes (Ctrl+4)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">🖨  Imprimantes</TextBlock>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Imprimantes et copieurs réseau" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="SpokaPilote détecte les imprimantes (SNMP, IPP), identifie le modèle exact et choisit le pilote : déjà présent, dépôt interne, Microsoft (WHQL), pilote universel du constructeur, ou pilote IPP intégré à Windows en dernier recours." />
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Plage (facultatif) :" Margin="0,0,8,0" />
                        <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding PrinterRange, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Vide = réseau local. Exemples : 10.0.1.0/24 · 192.168.1.20-192.168.1.80 · 10.0.2.15" />
                        <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Rechercher les imprimantes"
                                Style="{DynamicResource AccentButtonStyle}" Command="{Binding DiscoverPrintersCommand}" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Opacity="0.6" Margin="12" TextWrapping="Wrap" Panel.ZIndex="1" IsHitTestVisible="False"
                                   Text="Aucune imprimante listée. Lancez « Rechercher les imprimantes »." >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Printers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PrinterItem}">
                                    <StackPanel Margin="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.8" Text="{Binding Address}" FontFamily="Consolas" />
                                        <TextBlock Opacity="0.7" FontSize="12" Text="{Binding Details}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Text="{Binding InstalledAs}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Installation" />
                                <TextBlock Opacity="0.7" Margin="0,2,0,12" TextWrapping="Wrap"
                                           Text="Sélectionnez une imprimante à gauche, ou cherchez un pilote par modèle." />
                                <TextBlock Text="Pilote" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PrinterDriverOptions}" SelectedItem="{Binding SelectedPrinterDriver}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Nom de l'imprimante" Margin="0,12,0,4" />
                                <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Emplacement" Margin="0,12,0,4" />
                                <TextBox Text="{Binding PrinterLocation, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Margin="0,12,0,0" Content="Définir comme imprimante par défaut" IsChecked="{Binding PrinterSetDefault}" />
                                <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}"
                                        Content="Installer l'imprimante" Command="{Binding InstallPrinterCommand}" />
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding PrinterResult}" />

                                <Separator Margin="0,16" />
                                <TextBlock FontWeight="SemiBold" Text="Chercher un pilote par modèle" />
                                <TextBlock Opacity="0.7" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="Pour une imprimante USB, hors réseau, ou pour préparer une intervention." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Chercher" Command="{Binding FindPrinterDriverCommand}" />
                                    <TextBox Text="{Binding ManualPrinterModel, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Modèle exact, ex. KYOCERA TASKalfa 3253ci" />
                                </DockPanel>

                                <Separator Margin="0,16" />
                                <TextBlock FontWeight="SemiBold" Text="Profils d'imprimantes (configurer une fois, déployer partout)" />
                                <TextBlock Opacity="0.7" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="Exportez les imprimantes d'un poste bien configuré, puis appliquez ce profil sur les autres postes (conditions possibles par site ou par nom de poste)." />
                                <WrapPanel>
                                    <Button Content="Exporter ce poste..." Command="{Binding ExportPrinterProfileCommand}" Margin="0,0,8,8" />
                                    <Button Content="Appliquer un profil..." Command="{Binding DeployPrinterProfileCommand}" Margin="0,0,12,8" />
                                    <CheckBox Content="Simulation" IsChecked="{Binding PrinterDeployDryRun}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ====================================================== DÉPÔT -->
            <TabItem AutomationProperties.Name="Dépôt de pilotes" ToolTip="Dépôt de pilotes (Ctrl+5)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">🗄  Dépôt de pilotes</TextBlock>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Dépôt de pilotes de l'entreprise" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Pour déployer un parc : préparez un poste de référence par modèle, exportez ses pilotes vers un partage réseau, puis ajoutez ce partage ici. Les autres postes du même modèle s'installent depuis le dépôt, en priorité, même sans Internet." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Dépôts utilisés (local, clé USB ou \\serveur\partage)" />
                                <ListBox Margin="0,8,0,8" MinHeight="90" ItemsSource="{Binding RepositoryPaths}" SelectedItem="{Binding SelectedRepository}" />
                                <WrapPanel>
                                    <Button Content="Ajouter un dépôt..." Command="{Binding AddRepositoryCommand}" Margin="0,0,8,8" />
                                    <Button Content="Retirer" Command="{Binding RemoveRepositoryCommand}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Poste de référence" />
                                    <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,12"
                                               Text="Exporte tous les pilotes tiers de ce poste dans &lt;dépôt&gt;\Fabricant\Modèle\Windows." />
                                    <Button HorizontalAlignment="Left" Content="Exporter les pilotes de ce poste..." Command="{Binding ExportDriversCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Importer un pilote" />
                                    <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,12"
                                               Text="Ajoute au dépôt sélectionné un pilote récupéré sur le site officiel d'un constructeur (.zip, .cab ou dossier extrait)." />
                                    <Button HorizontalAlignment="Left" Content="Importer..." Command="{Binding ImportDriversCommand}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Pack officiel du constructeur (Dell, HP, Lenovo)" />
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Le pack de déploiement complet publié par le constructeur pour un modèle : plus besoin de poste de référence. Laissez le modèle vide pour ce poste." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Rechercher" Command="{Binding SearchDriverPacksCommand}" Margin="8,0,0,0" />
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PackOsChoices}" SelectedIndex="{Binding PackOs}" Width="130" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding PackModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="ex. Latitude 7420, EliteBook 840 G8, ThinkPad T14 Gen 3" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding DriverPacks}" SelectedItem="{Binding SelectedDriverPack}" MaxHeight="180" Margin="0,8,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Pack.VendorName, Mode=OneWay}" /> <Run Text="{Binding ModelLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Opacity="0.75" FontSize="12">
                                                    <Run Text="{Binding Pack.OsLabel, Mode=OneWay}" /> · <Run Text="{Binding Pack.Id, Mode=OneWay}" /> <Run Text="{Binding Pack.Version, Mode=OneWay}" /> · <Run Text="{Binding Pack.SizeLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button HorizontalAlignment="Left" Content="Télécharger dans le dépôt..." Command="{Binding DownloadDriverPackCommand}" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Pack hors ligne (poste sans réseau)" />
                                    <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,8"
                                               Text="PC neuf sans pilote réseau ? Sur ce poste : « spokapilote scan --json E:\poste.json » depuis la clé USB. Ici, choisissez ce rapport : SpokaPilote télécharge et vérifie ses pilotes. Annulez le choix du rapport pour préparer le pack de ce poste-ci." />
                                    <CheckBox Content="Inclure les mises à jour de tout le matériel" IsChecked="{Binding PackAllHardware}" Margin="0,0,0,8" />
                                    <Button HorizontalAlignment="Left" Content="Préparer un pack..." Command="{Binding BuildPackCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Rapport de parc" />
                                    <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,12"
                                               Text="Consolide les rapports de tous les postes (« spokapilote install --yes --output-dir \\serveur\rapports ») : postes à traiter, matériel sans pilote sur tout le parc, modèles." />
                                    <Button HorizontalAlignment="Left" Content="Générer le rapport de parc..." Command="{Binding FleetReportCommand}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding RepositoryResult}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== HISTORIQUE -->
            <TabItem AutomationProperties.Name="Historique" ToolTip="Historique (Ctrl+6)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">↩  Historique</TextBlock>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Historique et retour arrière" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Chaque installation est enregistrée. Annuler une intervention retire les paquets qu'elle a ajoutés : les périphériques reviennent à leur pilote précédent. Les sauvegardes complètes faites avant chaque intervention peuvent aussi être réinstallées." />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Interventions}" SelectedItem="{Binding SelectedIntervention}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.7" FontSize="12" Text="{Binding Id}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Button Content="Annuler cette intervention" Style="{DynamicResource AccentButtonStyle}" Command="{Binding RollbackCommand}" Margin="0,0,8,0" />
                                    <Button Content="Actualiser" Command="{Binding RefreshHistoryCommand}" />
                                </WrapPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SelectedInterventionDetails}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Réinstaller cette sauvegarde" Command="{Binding RestoreBackupCommand}" />
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Sauvegardes :" />
                            <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================== JOURNAL -->
            <TabItem AutomationProperties.Name="Journal" ToolTip="Journal (Ctrl+7)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">📜  Journal</TextBlock>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Ouvrir le dossier des journaux" Command="{Binding OpenLogsCommand}" />
                        <TextBlock Style="{StaticResource PageTitle}" Text="Journal" />
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <!-- ====================================================== PARAMÈTRES -->
            <TabItem AutomationProperties.Name="Paramètres" ToolTip="Paramètres (Ctrl+8)">
                <TabItem.Header>
                    <TextBlock Style="{StaticResource NavHeader}">⚙  Paramètres</TextBlock>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Paramètres" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Enregistrés dans %ProgramData%\SpokaPilote\settings.json : le même fichier peut être déployé sur tout le parc (GPO, Intune, script)." />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Interface" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Langue de l'interface" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedIndex="{Binding LanguageIndex}" Width="260"
                                              AutomationProperties.Name="Langue de l'interface" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" Text="{Binding LanguageNote, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"
                                           Text="Raccourcis : F5 analyser · Ctrl+1 à Ctrl+8 changer d'onglet · F1 aide en ligne." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Sources de pilotes" Margin="0,0,0,8" />
                                <CheckBox Content="Windows Update" IsChecked="{Binding Settings.UseWindowsUpdate}" Margin="0,4" />
                                <CheckBox Content="Interroger Windows Update directement même si le poste est géré par WSUS" IsChecked="{Binding Settings.WindowsUpdateBypassWsus}" Margin="24,4,0,4" />
                                <CheckBox Content="Microsoft Update Catalog (recherche par identifiant matériel)" IsChecked="{Binding Settings.UseMicrosoftCatalog}" Margin="0,4" />
                                <CheckBox Content="Catalogues officiels des constructeurs (Dell, HP, Lenovo)" IsChecked="{Binding Settings.UseOemCatalogs}" Margin="0,4" />
                                <CheckBox Content="Pilotes graphiques des fabricants (NVIDIA automatique ; Intel et AMD : lien officiel)" IsChecked="{Binding Settings.UseGpuVendorSources}" Margin="0,4" />
                                <StackPanel Orientation="Horizontal" Margin="24,4,0,4">
                                    <TextBlock Text="Branche NVIDIA :" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox SelectedValue="{Binding Settings.NvidiaBranch}" SelectedValuePath="Tag" Width="300">
                                        <ComboBoxItem Tag="studio" Content="Studio (stable, recommandé pour un parc)" />
                                        <ComboBoxItem Tag="gameready" Content="Game Ready (la plus récente)" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Content="Proposer aussi les mises à jour de BIOS et de firmware" IsChecked="{Binding Settings.IncludeBiosAndFirmware}" Margin="0,4" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Sécurité" Margin="0,0,0,8" />
                                <CheckBox Content="Créer un point de restauration avant installation" IsChecked="{Binding CreateRestorePoint}" Margin="0,4" />
                                <CheckBox Content="Sauvegarder les pilotes actuels avant installation" IsChecked="{Binding BackupDrivers}" Margin="0,4" />
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Toujours actif : HTTPS uniquement, domaines officiels uniquement, empreinte vérifiée, signature Authenticode d'un éditeur approuvé, et l'INF doit déclarer l'identifiant exact du matériel." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Maintenance automatique" Margin="0,0,0,4" />
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Tâche Windows exécutée en arrière-plan (compte système) : le poste s'entretient seul et peut déposer son rapport pour le suivi du parc." />
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding ScheduleTriggers}" SelectedIndex="{Binding ScheduleTrigger}" Width="190" Margin="0,0,8,8" />
                                    <ComboBox ItemsSource="{Binding ScheduleDays}" SelectedIndex="{Binding ScheduleDay}" Width="130" Margin="0,0,8,8" />
                                    <TextBlock Text="à" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,8" />
                                    <ComboBox ItemsSource="{Binding ScheduleModes}" SelectedIndex="{Binding ScheduleMode}" Width="260" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="Dossier des rapports du parc (facultatif, ex. \\serveur\rapports)" Margin="0,4,0,4" />
                                <TextBox Text="{Binding ScheduleOutputDir, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Activer" Style="{DynamicResource AccentButtonStyle}" Command="{Binding EnableScheduleCommand}" Margin="0,0,8,0" />
                                    <Button Content="Lancer maintenant" Command="{Binding RunScheduleNowCommand}" Margin="0,0,8,0" />
                                    <Button Content="Désactiver" Command="{Binding DisableScheduleCommand}" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" Text="{Binding ScheduleStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Politique de pilotes et console centrale" Margin="0,0,0,8" />
                                <TextBlock Text="Source de la politique (fichier, \\serveur\partage\driver-policy.json ou URL HTTPS ; vide = console centrale)" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <TextBox Text="{Binding Settings.PolicySource, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Adresse de la console centrale (ex. https://spokapilote.mon-entreprise.fr)" Margin="0,12,0,4" />
                                <TextBox Text="{Binding Settings.ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Jeton d'enrôlement des postes" Margin="0,12,0,4" />
                                <TextBox Text="{Binding Settings.ServerToken, UpdateSourceTrigger=PropertyChanged}" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Content="Tester la connexion" Command="{Binding TestServerCommand}" Margin="0,0,12,0" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ServerStatusText, Mode=OneWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="Une fois configurée, chaque analyse et chaque installation envoient leur rapport à la console. La console s'installe avec Docker : voir docs/CONSOLE-CENTRALE.md." />
                                <TextBlock FontWeight="SemiBold" Text="Actions à distance" Margin="0,16,0,4" />
                                <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="L'agent vérifie toutes les 15 minutes si la console a demandé une action pour ce poste (analyse, installation des pilotes manquants, imprimantes, annulation, mise à jour). Aucune autre commande n'est possible." />
                                <WrapPanel>
                                    <Button Content="Activer l'agent" Command="{Binding EnableAgentCommand}" Margin="0,0,8,0" />
                                    <Button Content="Désactiver" Command="{Binding DisableAgentCommand}" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" Text="{Binding AgentStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Imprimantes" Margin="0,0,0,8" />
                                <TextBlock Text="Catalogue d'imprimantes de l'organisation (URL HTTPS d'un fichier JSON, facultatif)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.PrinterCatalogUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}"
                                Content="Enregistrer" Command="{Binding SaveSettingsCommand}" />
                        <TextBlock Margin="0,24,0,0" Opacity="0.6" Text="{Binding AppVersionLabel, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ====================================================== BARRE D'ÉTAT -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Annuler" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="6" Margin="12,0" VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="Redémarrage nécessaire" Visibility="{Binding RebootPending, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="État" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
