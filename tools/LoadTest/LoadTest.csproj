<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Outil de test de charge de la console centrale (SpokaPilote Server) : génère un parc réaliste et mesure les temps de
    réponse. Uniquement pour le développement : il n'est ni livré dans l'image Docker ni dans l'installateur.
    Multiplateforme, comme le serveur : on surcharge la cible Windows du Directory.Build.props racine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <RootNamespace>SpokaPilote.LoadTest</RootNamespace>
    <AssemblyName>SpokaPilote.LoadTest</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
