<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Pas « SpokaPilote » : Windows ignore la casse et la CLI s'appelle spokapilote.exe dans le même dossier. -->
    <AssemblyName>SpokaPilote.App</AssemblyName>
    <AssemblyTitle>SpokaPilote</AssemblyTitle>
    <RootNamespace>SpokaPilote.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpokaPilote.ico</ApplicationIcon>
    <!-- Thème Fluent natif de WPF .NET 9 (API marquée expérimentale) -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpokaPilote.Core\SpokaPilote.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\SpokaPilote.ico" />
    <EmbeddedResource Include="Localization\en.json" />
  </ItemGroup>
</Project>
