<UserControl x:Class="SpokaPilote.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SpokaPilote.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
             xmlns:l="clr-namespace:SpokaPilote.App.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             AutomationProperties.Name="Accueil">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,28" MaxWidth="960">

            <!-- ============================================ bandeaux : configuration en quarantaine, mise à jour, droits -->
            <Border Style="{StaticResource InfoBarWarning}" Visibility="{Binding Shell.HasQuarantineNotice, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Configuration mise en quarantaine">
                <DockPanel>
                    <app:Glyph Style="{StaticResource WarningIcon}" />
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Vérifier et restaurer"
                            Command="{Binding Shell.RestoreQuarantineCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Configuration mise en quarantaine.</Run>
                        <Run Text="{Binding Shell.QuarantineNotice, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource InfoBar}" Visibility="{Binding Shell.HasInstallerUpdate, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <app:Glyph Style="{StaticResource InfoIcon}" Text="&#xE896;" />
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Mettre à jour"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding Shell.InstallUpdateCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding Shell.UpdateLabel, Mode=OneWay}" />
                        <Run Text="Téléchargement depuis GitHub, vérifié (taille + SHA-256), puis installation automatique." />
                    </TextBlock>
                </DockPanel>
            </Border>
            <!-- Mode portable : aucun installeur, l'archive portable vérifiée est déposée sur la clé. -->
            <Border Style="{StaticResource InfoBar}" Visibility="{Binding Shell.HasPortableUpdate, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <app:Glyph Style="{StaticResource InfoIcon}" Text="&#xE896;" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Content="Page de la version" Command="{Binding Shell.OpenReleasePageCommand}" Margin="0,0,8,0" />
                        <Button Content="Télécharger sur la clé" Style="{DynamicResource AccentButtonStyle}" Command="{Binding Shell.DownloadPortableUpdateCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{Binding Shell.UpdateLabel, Mode=OneWay}" />
                        <Run Text="Mode portable : téléchargez la nouvelle version. L'archive est vérifiée (taille + SHA-256) et rangée sur la clé ; extrayez-la ensuite par-dessus l'ancienne version." />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource InfoBar}" Visibility="{Binding Shell.IsNotAdmin, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <app:Glyph Style="{StaticResource InfoIcon}" Text="&#xE7EF;" />
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Relancer en administrateur"
                            Command="{Binding Shell.RelaunchAsAdminCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Mode analyse.</Run>
                        <Run>L'analyse fonctionne ; l'installation des pilotes demande les droits administrateur.</Run>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- ============================================ identité du poste -->
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,2" Text="Ce poste" />
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding MachineModel, Mode=OneWay}" AutomationProperties.Name="Modèle du poste" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" Text="{Binding MachineLine, Mode=OneWay}" AutomationProperties.Name="Identité du poste" />
            <Expander Header="Plus d'informations sur le poste" Margin="0,0,0,20" HorizontalAlignment="Left"
                      AutomationProperties.Name="Plus d'informations sur le poste">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}" Text="{Binding MachineDetails, Mode=OneWay}" />
            </Expander>

            <!-- ============================================ action principale -->
            <Border Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Note de santé A à E (couleur selon la note). -->
                    <Border Width="76" Height="76" CornerRadius="38" VerticalAlignment="Top" Margin="0,0,22,0"
                            AutomationProperties.Name="{Binding GradeAccessibleName, Mode=OneWay}" Focusable="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GradeKind}" Value="good">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GradeKind}" Value="warn">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GradeKind}" Value="bad">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Text="{Binding Grade, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GradeKind}" Value="good">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeKind}" Value="warn">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeKind}" Value="bad">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,2">
                            <Run Text="Santé des pilotes :" />
                            <Run FontWeight="SemiBold" Text="{Binding GradeLabel, Mode=OneWay}" />
                            <Run Text="{Binding ScoreText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Headline, Mode=OneWay}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Résultat de l'analyse" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Secondary}" Text="{Binding SubHeadline, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="200">
                        <Button Padding="24,11" FontSize="15" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding PrimaryLabel, Mode=OneWay}" Command="{Binding PrimaryCommand}"
                                ToolTip="{Binding PrimaryHelp, Mode=OneWay}"
                                AutomationProperties.Name="{Binding PrimaryLabel, Mode=OneWay}"
                                AutomationProperties.HelpText="{Binding PrimaryHelp, Mode=OneWay}"
                                Visibility="{Binding ShowPrimaryButton, Converter={StaticResource BoolToVisibility}}" />
                        <Border Padding="18,10" CornerRadius="6" HorizontalAlignment="Stretch"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <app:Glyph Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="&#xE73E;" />
                                <TextBlock Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{Binding PrimaryLabel, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource LinkButton}" Content="Voir le détail" Command="{Binding ShowDetailsCommand}" />
                            <Button Style="{StaticResource LinkButton}" Content="Analyser à nouveau" Command="{Binding Shell.ScanCommand}"
                                    ToolTip="Analyser à nouveau (F5)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Progression en clair pendant l'analyse ou l'installation. -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"
                                Visibility="{Binding Shell.IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Height="4" Value="{Binding Shell.Progress, Mode=OneWay}" IsIndeterminate="{Binding Shell.ProgressIndeterminate, Mode=OneWay}"
                                     AutomationProperties.Name="Progression" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Annuler" Command="{Binding Shell.CancelCommand}" Margin="12,0,0,0" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Shell.Status, Mode=OneWay}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Résultat de la dernière opération (installation, erreur d'analyse...). -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0" Style="{StaticResource InfoBarByKind}" Tag="{Binding MessageKind}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <app:Glyph Style="{StaticResource IconByKind}" Tag="{Binding MessageKind}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Padding="6,2" VerticalAlignment="Top"
                                    Command="{Binding DismissMessageCommand}" ToolTip="Masquer ce message" AutomationProperties.Name="Masquer ce message">
                                <app:Glyph Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;" />
                            </Button>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Message, Mode=OneWay}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================ redémarrage nécessaire -->
            <Border Style="{StaticResource InfoBarWarning}" Margin="0,12,0,0"
                    Visibility="{Binding Shell.RebootPending, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <app:Glyph Style="{StaticResource WarningIcon}" />
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Content="Redémarrer maintenant"
                            Command="{Binding Shell.RestartCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Redémarrage nécessaire.</Run>
                        <Run>Certains pilotes ne fonctionneront qu'après le redémarrage du poste.</Run>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- ============================================ avant la première analyse : comment ça marche -->
            <UniformGrid Columns="3" Margin="0,16,0,0" Visibility="{Binding HasScan, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <app:Glyph Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE721;" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource CardTitle}" Text="1. Analyser" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Inventaire du matériel et recherche des pilotes, sans rien modifier." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <app:Glyph Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE72E;" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource CardTitle}" Text="2. Vérifier" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Sources officielles uniquement : Windows Update, Dell, HP, Lenovo, Surface, NVIDIA, votre dépôt." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <app:Glyph Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE896;" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource CardTitle}" Text="3. Installer" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Avec votre accord, après une sauvegarde. Retour arrière possible dans l'Historique." />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================ après l'analyse : principaux constats et BIOS -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Points importants" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Aucun problème détecté sur ce poste." Margin="0,0,0,6"
                               Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding TopFindings, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FindingItem}">
                                <DockPanel Margin="0,0,0,10">
                                    <app:Glyph Style="{StaticResource IconByKind}" Tag="{Binding Kind}" FontSize="15" Margin="0,1,12,0" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Title}" ToolTip="{Binding Detail}"
                                               AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding SeverityName}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- État du BIOS et des firmwares : information seulement, jamais installé sans l'option BIOS / firmware. -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,0" Padding="0,12,0,0"
                            AutomationProperties.Name="BIOS et firmwares">
                        <StackPanel>
                            <DockPanel>
                                <app:Glyph Style="{StaticResource IconByKind}" FontSize="15" Margin="0,1,12,0" Tag="{Binding BiosKind, Mode=OneWay}" />
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Content="Page officielle du BIOS" ToolTip="{Binding BiosLink, Mode=OneWay}"
                                        AutomationProperties.Name="Ouvrir la page officielle du BIOS"
                                        Command="{Binding Shell.OpenUrlCommand}" CommandParameter="{Binding BiosLink, Mode=OneWay}"
                                        Visibility="{Binding HasBiosLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding BiosStatusText, Mode=OneWay}"
                                           AutomationProperties.Name="État du BIOS" />
                            </DockPanel>
                            <TextBlock Margin="27,6,0,0" Style="{StaticResource Caption}" Text="{Binding BiosWarningText, Mode=OneWay}"
                                       AutomationProperties.Name="Précautions avant la mise à jour du BIOS"
                                       Visibility="{Binding BiosWarningText, Mode=OneWay, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Margin="27,6,0,0" Style="{StaticResource Caption}" Text="{Binding FirmwareComponentsText, Mode=OneWay}"
                                       AutomationProperties.Name="Firmwares de stations d'accueil et Thunderbolt"
                                       Visibility="{Binding FirmwareComponentsText, Mode=OneWay, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </Border>

                    <!-- Sources qui n'ont pas répondu : résultats possiblement incomplets. -->
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding HasSourceWarnings, Converter={StaticResource BoolToVisibility}}">
                        <app:Glyph Style="{StaticResource WarningIcon}" FontSize="15" Margin="0,1,12,0" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding SourceWarningText, Mode=OneWay}" />
                    </DockPanel>

                    <Expander Margin="0,14,0,0" Header="{Binding AllFindingsHeader, Mode=OneWay}"
                              Visibility="{Binding HasMoreFindings, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AllFindings, Mode=OneWay}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingItem}">
                                    <DockPanel Margin="0,0,0,10">
                                        <app:Glyph Style="{StaticResource IconByKind}" Tag="{Binding Kind}" FontSize="14" Margin="0,1,12,0" />
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
