<UserControl x:Class="SpokaPilote.App.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SpokaPilote.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DevicesViewModel}"
             AutomationProperties.Name="Périphériques">
    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Périphériques" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Le matériel détecté et son état. Sélectionnez un périphérique en erreur : SpokaPilote explique le problème et propose une réparation guidée." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding Shell.HasScan, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel AutomationProperties.Name="Filtrer les périphériques">
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DeviceFilter" AutomationProperties.Name="Périphériques en erreur"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=problems}">
                    <TextBlock><Run Text="En erreur" /> <Run Text="{Binding ProblemCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DeviceFilter" AutomationProperties.Name="Périphériques sans pilote trouvé"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=unresolved}">
                    <TextBlock><Run Text="Sans pilote trouvé" /> <Run Text="{Binding UnresolvedCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="DeviceFilter" AutomationProperties.Name="Tous les périphériques"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=all}">
                    <TextBlock><Run Text="Tous" /> <Run Text="{Binding AllCount, Mode=OneWay, StringFormat='({0})'}" /></TextBlock>
                </RadioButton>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.6*" MinWidth="250" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectedItem="{Binding SelectedDevice}" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutomationProperties.Name="Liste des périphériques"
                      Visibility="{Binding IsListEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserResize="False" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <app:Glyph HorizontalAlignment="Center" FontSize="14">
                                    <app:Glyph.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="problem">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="disabled">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </app:Glyph.Style>
                                </app:Glyph>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Périphérique" Binding="{Binding Name}" Width="2*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Class}" Width="0.8*" MinWidth="92" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="1.3*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- État vide : dire quoi faire ensuite. -->
            <Border VerticalAlignment="Top" Padding="28,24"
                    Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <!-- Avant la première analyse, l'état vide occupe toute la largeur (pas de volet de détail). -->
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Shell.HasScan}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <app:Glyph Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="&#xE772;" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle, Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" Style="{StaticResource Secondary}" Text="{Binding EmptyText, Mode=OneWay}" />
                    <Button Margin="0,16,0,0" HorizontalAlignment="Center" Style="{DynamicResource AccentButtonStyle}" Content="Analyser ce poste"
                            Command="{Binding Shell.ScanCommand}" ToolTip="Analyser ce poste (F5)"
                            Visibility="{Binding Shell.HasScan, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                </StackPanel>
            </Border>

            <!-- ============================================ détail du périphérique et réparation guidée -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch" Padding="18,16"
                    Visibility="{Binding Shell.HasScan, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                               Text="Sélectionnez un périphérique pour voir son état, son pilote et les réparations possibles."
                               Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedDevice.Name, Mode=OneWay}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedDevice.Status, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}" Text="{Binding SelectedDevice.Hint, Mode=OneWay}"
                                       Visibility="{Binding SelectedDevice.HasHint, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

                            <TextBlock Margin="0,14,0,2" Style="{StaticResource Caption}" Text="Pilote actuel" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding SelectedDevice.DriverSummary, Mode=OneWay}" />

                            <!-- Réparation guidée (périphérique en erreur). -->
                            <Border Margin="0,16,0,0" Padding="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{Binding HasRepairPlan, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="Réparation guidée" />
                                    <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="{Binding RepairPlanText, Mode=OneWay}" />
                                    <ComboBox ItemsSource="{Binding RepairPlan.Actions, Mode=OneWay}" SelectedItem="{Binding SelectedRepairAction}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Action de réparation" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding SelectedRepairAction.Explanation, Mode=OneWay}" />
                                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Appliquer la réparation" Style="{DynamicResource AccentButtonStyle}"
                                            Command="{Binding ExecuteRepairCommand}" />
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding RepairResultText, Mode=OneWay}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="{Binding RepairResultText, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </Border>

                            <!-- Détails techniques à la demande. -->
                            <Expander Margin="0,16,0,0" Header="Détails techniques">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="Catégorie et fournisseur" />
                                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                        <Run Text="{Binding SelectedDevice.Class, Mode=OneWay}" /> · <Run Text="{Binding SelectedDevice.Provider, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" Text="Identifiants matériels (copiables)" />
                                    <TextBox Style="{StaticResource Mono}" Text="{Binding SelectedDevice.TechnicalIds, Mode=OneWay}"
                                             AutomationProperties.Name="Identifiants matériels" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <CheckBox Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Left"
                  Content="Afficher aussi les périphériques logiciels et virtuels" IsChecked="{Binding ShowAllDevices}"
                  Visibility="{Binding Shell.HasScan, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
