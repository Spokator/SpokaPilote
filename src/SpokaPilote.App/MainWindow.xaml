<Window x:Class="SpokaPilote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SpokaPilote.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SpokaPilote.App.ViewModels"
        xmlns:views="clr-namespace:SpokaPilote.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpokaPilote — pilotes de confiance"
        Width="1240" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================== NAVIGATION -->
        <DockPanel Grid.RowSpan="2" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,12,18">
                <Image Source="/Assets/SpokaPilote.ico" Width="24" Height="24" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="SpokaPilote" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="20,8,12,4">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding AppVersionLabel, Mode=OneWay}" />
                <TextBlock Style="{StaticResource Caption}" Text="Mode analyse (sans droits administrateur)"
                           Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ListBox x:Name="Nav" SelectedIndex="{Binding PageIndex}" ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Navigation principale">
                <ListBoxItem AutomationProperties.Name="Accueil" ToolTip="Accueil (Ctrl+1)">
                    <StackPanel Orientation="Horizontal">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE80F;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Accueil" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Pilotes" ToolTip="Pilotes (Ctrl+2)">
                    <DockPanel LastChildFill="False">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE896;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Pilotes" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                Visibility="{Binding Drivers.ActionableCount, Converter={StaticResource VisibleWhen}}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Text="{Binding Drivers.ActionableCount, Mode=OneWay}" />
                        </Border>
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Périphériques" ToolTip="Périphériques (Ctrl+3)">
                    <DockPanel LastChildFill="False">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE772;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Périphériques" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Background="{DynamicResource SystemFillColorCautionBrush}"
                                Visibility="{Binding Devices.ProblemCount, Converter={StaticResource VisibleWhen}}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Text="{Binding Devices.ProblemCount, Mode=OneWay}" />
                        </Border>
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Historique" ToolTip="Historique (Ctrl+4)">
                    <StackPanel Orientation="Horizontal">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE81C;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Historique" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Outils" ToolTip="Outils (Ctrl+5)">
                    <StackPanel Orientation="Horizontal">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE90F;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Outils" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Paramètres" ToolTip="Paramètres (Ctrl+6)">
                    <StackPanel Orientation="Horizontal">
                        <app:Glyph Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Paramètres" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ====================================================== PAGES -->
        <Border Grid.Column="1" x:Name="PageHost" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <views:HomePage DataContext="{Binding Home}"
                                Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}" />
                <views:DriversPage DataContext="{Binding Drivers}"
                                   Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}" />
                <views:DevicesPage DataContext="{Binding Devices}"
                                   Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}" />
                <views:HistoryPage DataContext="{Binding History}"
                                   Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=3}" />
                <views:ToolsPage DataContext="{Binding Tools}"
                                 Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=4}" />
                <views:SettingsPage DataContext="{Binding SettingsPage}"
                                    Visibility="{Binding DataContext.PageIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=5}" />
            </Grid>
        </Border>

        <!-- ====================================================== BARRE D'ÉTAT -->
        <Border Grid.Row="1" Grid.Column="1" BorderThickness="1,1,0,0" Padding="16,7"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Annuler" Command="{Binding CancelCommand}" Padding="12,3"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar DockPanel.Dock="Right" Width="180" Height="4" Margin="12,0" VerticalAlignment="Center"
                             Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="Progression" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"
                            Visibility="{Binding RebootPending, Converter={StaticResource BoolToVisibility}}">
                    <app:Glyph Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="&#xE7BA;" />
                    <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Text="Redémarrage nécessaire" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Caption}" MaxWidth="360"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="{Binding PortableLabel, Mode=OneWay}" ToolTip="{Binding PortableDetails, Mode=OneWay}"
                           Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="État" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
